# Copy this file to .env and fill in real values. .env is never committed.
APP_NAME=meenmitra
APP_ENV=local
LOG_LEVEL=INFO
DATA_FILE=data/sample_records.json

# Paste your Neon connection string here, in .env only.
# It starts with postgresql:// and ends with ?sslmode=require.
DATABASE_URL=postgresql://localhost:5432/meenmitra
